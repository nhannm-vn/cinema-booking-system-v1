# ==============================================================================
# CINEMA BOOKING APP - CẤU HÌNH MÔI TRƯỜNG (.env.example)
# ==============================================================================

# 1. Supabase Project (BẮT BUỘC ĐỂ CHẠY APP)
# Vào supabase.com -> Chọn Project -> Project Settings -> API:
# - URL: Copy 'Project URL'
# - ANON_KEY: Copy 'Project API Keys' -> 'anon' 'public'
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. SePay Payment Gateway / VietQR (Dành cho Supabase Edge Functions & Webhook)
SEPAY_API_KEY=your_sepay_api_key_or_token
SEPAY_ACCOUNT_NO=0000123456789
SEPAY_BANK=MBBank
SEPAY_WEBHOOK_URL=https://your-project-ref.supabase.co/functions/v1/sepay-webhook
